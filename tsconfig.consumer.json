// Optional starting point for a project that uses tsx-to-pdf:
//   { "extends": "tsx-to-pdf/tsconfig", "include": ["**/*.ts", "**/*.tsx"] }
//
// The build does not depend on this — it layers the `jsx` pair on at build time
// regardless. Extending it just makes the editor and `tsc --noEmit` agree with
// how the document is really compiled.
//
// Deliberately no `types`: naming one here would make @types/node a hard
// requirement for anyone who extends this, and a document does not need it.
{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true
  }
}
